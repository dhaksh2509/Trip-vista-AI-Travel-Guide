# ==============================================================================
# TripVista — AI Travel Guide Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local frontend development
# or to .env for backend services.
# NEVER commit your actual API keys or credentials to version control.
# ==============================================================================

# Frontend (Next.js - Port 3000)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend (Express - Port 5000)
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/tripvista_db

# External APIs
WEATHER_API_KEY=your_openweather_api_key_here
